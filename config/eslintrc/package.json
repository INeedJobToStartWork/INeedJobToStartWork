{
	"name": "@ineedj/eslintrc",
	"version": "2.0.0",
	"description": "INEEDJ config for Eslint",
	"keywords": [
		"eslintrc",
		"strict",
		"hardcore",
		"ineedj",
		"ineedjobtostartwork"
	],
	"homepage": "https://github.com/INeedJobToStartWork/INeedJobToStartWork",
	"bugs": "https://github.com/INeedJobToStartWork/INeedJobToStartWork/issues/new/choose",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/INeedJobToStartWork/INeedJobToStartWork",
		"directory": "config/eslintrc"
	},
	"license": "MIT",
	"author": "ineedjobtostartwork",
	"type": "module",
	"exports": {
		".": {
			"types": {
				"import": "./index.d.ts",
				"require": "./index.d.cts"
			},
			"import": "./index.js",
			"require": "./index.cjs",
			"*": "./*"
		}
	},
	"scripts": {
		"------------------------UTILS--------------------------": "",
		"lint": "pnpm eslint .",
		"lint:fix": "pnpm eslint . --fix",
		"format": "pnpm prettier . --write && pnpm prettier . --check",
		"------------------------BUILDS-------------------------": "",
		"dev": "pnpm tsup-node --config ./config/tsuprc/tsup.dev.ts",
		"build": "pnpm tsup-node --config ./config/tsuprc/tsup.prod.ts",
		"build:dts": "pnpm dts-bundle-generator --config ./config/dts-bundle-generator/dts-bundle-generator.cjs",
		"build:npm": "pnpm npm:prepack && pnpm tsup-node --config ./config/tsuprc/tsup.prod.ts && pnpm npm:postpack",
		"------------------------DEPLOYS------------------------": "",
		"start": "pnpm exec eslint-config-inspector",
		"npm:prepack": "clean-package",
		"npm:postpack": "clean-package restore",
		"prepublishOnly": "pnpm build:npm"
	},
	"dependencies": {
		"@eslint/compat": "2.1.1",
		"@next/eslint-plugin-next": "16.4.6",
		"@rushstack/eslint-patch": "1.16.1",
		"@stylistic/eslint-plugin": "6.0.1",
		"@typescript-eslint/eslint-plugin": "8.73.0",
		"@typescript-eslint/parser": "8.73.0",
		"@vitest/eslint-plugin": "1.6.28",
		"confusing-browser-globals": "1.0.11",
		"eslint": "10.15.0",
		"eslint-config-flat-gitignore": "2.4.0",
		"eslint-flat-config-utils": "3.2.0",
		"eslint-import-resolver-node": "0.4.0",
		"eslint-plugin-array-func": "5.1.1",
		"eslint-plugin-ban": "2.0.0",
		"eslint-plugin-better-tailwindcss": "4.11.0",
		"eslint-plugin-command": "4.0.0",
		"eslint-plugin-compat": "7.0.2",
		"eslint-plugin-css-modules": "2.12.0",
		"eslint-plugin-header": "3.1.1",
		"eslint-plugin-import": "2.32.0",
		"eslint-plugin-jsonc": "3.4.2",
		"eslint-plugin-jsx-a11y": "6.10.2",
		"eslint-plugin-markdownlint": "1.0.0",
		"eslint-plugin-mdx": "3.10.1",
		"eslint-plugin-n": "18.5.0",
		"eslint-plugin-no-explicit-type-exports": "0.12.1",
		"eslint-plugin-no-unsanitized": "4.1.5",
		"eslint-plugin-only-error": "1.0.2",
		"eslint-plugin-only-warn": "1.2.1",
		"eslint-plugin-optimize-regex": "1.2.1",
		"eslint-plugin-perfectionist": "5.14.0",
		"eslint-plugin-pii": "1.0.2",
		"eslint-plugin-promise": "7.3.0",
		"eslint-plugin-react": "7.37.5",
		"eslint-plugin-react-form-fields": "1.2.22",
		"eslint-plugin-react-hook-form": "0.3.1",
		"eslint-plugin-react-hooks": "7.1.1",
		"eslint-plugin-react-perf": "3.4.0",
		"eslint-plugin-react-prefer-function-component": "5.0.0",
		"eslint-plugin-react-refresh": "0.5.8",
		"eslint-plugin-security": "4.2.1",
		"eslint-plugin-sonarjs": "4.2.2",
		"eslint-plugin-ssr-friendly": "1.3.0",
		"eslint-plugin-storybook": "10.6.7",
		"eslint-plugin-tailwindcss": "4.4.0",
		"eslint-plugin-toml": "1.5.0",
		"eslint-plugin-tsdoc": "0.5.4",
		"eslint-plugin-turbo": "2.11.11",
		"eslint-plugin-typescript-compat": "1.0.2",
		"eslint-plugin-typescript-sort-keys": "3.3.0",
		"eslint-plugin-unicorn": "80.0.0",
		"eslint-plugin-unused-imports": "4.4.1",
		"eslint-plugin-validate-jsx-nesting": "0.1.1",
		"eslint-plugin-yml": "3.10.0",
		"globals": "17.14.0",
		"local-pkg": "2.0.0"
	},
	"devDependencies": {
		"@eslint/config-inspector": "^3.5.0",
		"@ineedj/prettierrc": "^3.0.0",
		"@ineedj/tsconfig": "workspace:*",
		"@ineedj/tsuprc": "workspace:*",
		"@types/eslint-plugin-security": "^3.0.1",
		"clean-package": "^2.2.0",
		"dts-bundle-generator": "^10.0.0",
		"esbuild-plugin-copy": "^2.1.1",
		"eslint-typegen": "^2.3.2",
		"tsup": "^9.0.0",
		"typescript": "~6.0.3"
	},
	"publishConfig": {
		"directory": "dist",
		"provenance": true
	}
}
